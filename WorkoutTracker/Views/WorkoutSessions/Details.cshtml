@model WorkoutTracker.Models.WorkoutSession

@{
    ViewData["Title"] = "Szczegóły treningu";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">📋 Szczegóły sesji treningowej</h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Data treningu</dt>
                        <dd class="col-sm-8">@Model.Date.ToShortDateString()</dd>

                        <dt class="col-sm-4">Plan treningowy</dt>
                        <dd class="col-sm-8">@(Model.WorkoutPlan?.Name ?? "Brak przypisanego planu")</dd>

                        <dt class="col-sm-4">Czas trwania</dt>
                        <dd class="col-sm-8">@Model.DurationMinutes min</dd>

                        <dt class="col-sm-4">Notatki</dt>
                        <dd class="col-sm-8">@(!string.IsNullOrEmpty(Model.Notes) ? Model.Notes : "Brak notatek")</dd>
                    </dl>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">Powrót do listy</a>
                    <div>
                        <a asp-action="Edit" asp-route-id="@Model.WorkoutSessionId" class="btn btn-warning">Edytuj</a>
                        <a asp-action="Delete" asp-route-id="@Model.WorkoutSessionId" class="btn btn-danger">Usuń</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>