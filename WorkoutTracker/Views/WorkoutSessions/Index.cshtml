@model IEnumerable<WorkoutTracker.Models.WorkoutSession>

@{
    ViewData["Title"] = "Sesje treningowe";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>🔥 Twoje sesje</h2>
        <a asp-action="Create" class="btn btn-primary">Dodaj nowy trening</a>
    </div>

    <table class="table table-hover shadow-sm bg-white rounded">
        <thead class="table-dark">
            <tr>
                <th>Data</th>
                <th>Plan</th>
                <th>Czas (min)</th>
                <th>Opcje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Date.ToShortDateString()</td>
                    <td>@item.WorkoutPlan?.Name</td>
                    <td>@item.DurationMinutes</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.WorkoutSessionId" class="btn btn-sm btn-info">Szczegóły</a>
                        <a asp-action="Edit" asp-route-id="@item.WorkoutSessionId" class="btn btn-sm btn-warning">Edytuj</a>
                        <a asp-action="Delete" asp-route-id="@item.WorkoutSessionId" class="btn btn-sm btn-danger">Usuń</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>